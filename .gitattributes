# Everything here is consumed by Linux containers or by a shell, so it must keep LF endings
# regardless of the platform it was cloned on. Git for Windows defaults to core.autocrlf=true,
# which would otherwise rewrite these files to CRLF on checkout and break them.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
.env    text eol=lf

# Binary or generated, never touch.
*.jar binary
*.png binary
*.pdf binary
